# Sentry (Observability)
# DSN is split server/client so the public client bundle only ships the public key.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Required only at build time for source-map upload and release creation.
# In Vercel, install the Sentry integration to auto-provision SENTRY_AUTH_TOKEN.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional. Defaults to VERCEL_GIT_COMMIT_SHA on Vercel.
SENTRY_RELEASE=

# Plausible (Analytics)
# Set to the bare domain the site is served on (e.g. cortex.xyz).
# Leave empty in preview/local to disable the tracker. The browser loads
# Plausible through same-origin proxy paths defined in next.config.ts.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
